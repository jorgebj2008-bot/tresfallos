    "subtema": "marcas",
    "dificultad": 3,
    "tipo": "test",
    "enunciado": "Hay una línea continua junto a una discontinua y tú circulas por el lado de la discontinua. ¿Puedes cruzarlas para adelantar?",
    "imagen": null,
    "opciones": [
      {
        "texto": "Sí, si es seguro: manda la línea que está de tu lado.",
        "correcta": true,
        "explicacion": "Quien tiene la continua de su lado no puede cruzarlas."
      },
      {
        "texto": "No, nunca se puede cruzar si hay una continua.",
        "correcta": false,
        "explicacion": "Desconfía del «nunca»: depende de qué línea esté de tu lado.",
        "error_tipo": "trampa_siempre_nunca"
      },
      {
        "texto": "Solo de noche.",
        "correcta": false,
        "explicacion": "No depende de la hora.",
        "error_tipo": "lectura_matiz"
      }
    ],
    "error_tipo": [
      "lectura_matiz",
      "trampa_siempre_nunca"
    ],
    "fuente": "RGC art. 167",
    "revisar": false
  },
