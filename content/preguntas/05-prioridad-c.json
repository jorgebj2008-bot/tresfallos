      {
        "texto": "Esperar a que pasen los de enfrente.",
        "correcta": false,
        "explicacion": "Esa sería la señal contraria.",
        "error_tipo": "confunde_senales"
      },
      {
        "texto": "Pasar a la vez que el otro.",
        "correcta": false,
        "explicacion": "No caben dos.",
        "error_tipo": "confunde_conceptos"
      }
    ],
    "error_tipo": [
      "confunde_conceptos",
