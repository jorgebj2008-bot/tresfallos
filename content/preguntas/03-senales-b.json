    "subtema": "obras",
    "dificultad": 2,
    "tipo": "test",
    "enunciado": "Si una señal de obras (fondo amarillo) contradice a una señal fija, ¿cuál manda?",
    "imagen": null,
    "opciones": [
      {
        "texto": "La de obras.",
        "correcta": true,
        "explicacion": "La señalización de obras es temporal y prevalece sobre la permanente."
      },
      {
        "texto": "La fija, porque es oficial.",
        "correcta": false,
        "explicacion": "Las dos son oficiales; manda la de obras.",
        "error_tipo": "jerarquia_senales"
      },
      {
        "texto": "La más antigua.",
        "correcta": false,
        "explicacion": "No va por antigüedad.",
        "error_tipo": "jerarquia_senales"
      }
    ],
    "error_tipo": [
      "jerarquia_senales"
    ],
    "fuente": "RGC art. 133",
    "revisar": false
  },
  {
