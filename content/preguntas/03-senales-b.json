    "subtema": "jerarquia",
    "dificultad": 3,
    "tipo": "test",
    "enunciado": "Unos conos cierran un carril que, según las marcas viales, se puede usar. ¿Qué obedeces?",
    "imagen": null,
    "opciones": [
      {
        "texto": "Los conos.",
        "correcta": true,
        "explicacion": "La señalización circunstancial (conos, balizas) prevalece sobre semáforos, señales y marcas."
      },
      {
        "texto": "Las marcas viales.",
        "correcta": false,
        "explicacion": "Las marcas viales son lo último en la jerarquía.",
        "error_tipo": "jerarquia_senales"
      },
      {
        "texto": "Lo que te parezca más seguro.",
        "correcta": false,
        "explicacion": "Hay un orden fijo.",
        "error_tipo": "jerarquia_senales"
      }
    ],
    "error_tipo": [
      "jerarquia_senales"
    ],
    "fuente": "RGC art. 133",
    "revisar": false
  },
  {
    "id": "SEN-0102",
